{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/demo/hooks/log_messages.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/demo/hooks/log_messages.py\""
          }
        ]
      }
    ]
  }
}
